    "cardRadius": "cardRadius",
    "globalBackground": "Qt globalBackground",
    "panelBackground": "Qt panelBackground",
    "textColor": "Qt textColor",
    "mutedTextColor": "Qt mutedTextColor",
    "accentColor": "Qt accentColor",
    "dangerColor": "Qt dangerColor",
    "successColor": "Qt successColor",
    "borderColor": "Qt borderColor",
    "webviewBackground": "webview background",
    "webviewBackgroundImage": "webview background image",
    "webviewBackgroundImageOpacity": "webview background image opacity",
    "webviewCanvas": "webview canvas",
    "webviewForeground": "webview foreground (text)",
    "webviewLink": "webview link",
    "webviewBorder": "webview border",
    "deckHoverBackground": "deck hover background",
    "gradientStart": "reviewer gradient start",
    "gradientEnd": "reviewer gradient end",
    "cardBackground": "reviewer card background",
    "menuGlowEnabled": "menu glow enabled",
    "menuGlowColor": "menu glow color",
    "menuGlowSpeed": "menu glow speed",
    "menuGlowIntensity": "menu glow intensity",
    "menuGlowBlur": "menu glow blur",
    "forceCardStyling": "force card styling",
}

FIELD_HELP: Dict[str, str] = {
    "fontFamily": "Primary font family used across Anki.",
    "cardFontSize": "Default font size for card text.",
    "cardMaxWidth": "Maximum width of the card container (e.g. 800px).",
    "cardRadius": "Corner radius of the card container (e.g. 12px).",
    "globalBackground": "Background of the main window and dialogs (Qt widgets).",
    "panelBackground": "Background of toolbars, sidebars, and panels (Qt widgets).",
    "textColor": "Primary text color in Qt widgets.",
    "mutedTextColor": "Secondary/disabled text color in Qt widgets.",
    "accentColor": "Highlight, focus rings, and selected items (Qt).",
    "dangerColor": "Warning/error accents (Qt).",
    "successColor": "Success/confirmation accents (Qt).",
    "borderColor": "Borders for Qt widgets.",
    "webviewBackground": "Main page background for Deck Browser & Overview.",
    "webviewBackgroundImage": "Optional image (file or data URI) behind main background (covers entire page). Images should be 2560x1440 for lossless scaling.",
    "webviewBackgroundImageOpacity": "Transparency of background image (0.0 = invisible, 1.0 = fully opaque).",
    "webviewCanvas": "Tables and content panels within webviews.",
    "webviewForeground": "Text color in Deck Browser & Overview.",
    "webviewLink": "Link color in HTML pages.",
    "webviewBorder": "Borders for tables and panels in webviews.",
    "deckHoverBackground": "Background when hovering over a deck row.",
    "gradientStart": "Top color of Reviewer background gradient.",
    "gradientEnd": "Bottom color of Reviewer background gradient.",
    "cardBackground": "Reviewer card container background.",
    "menuGlowEnabled": "Enable pulsing glow effect on menus and buttons.",
    "menuGlowColor": "Color of the glow effect.",
    "menuGlowSpeed": "Duration of one glow pulse cycle in seconds (e.g., 2.0).",
    "menuGlowIntensity": "Maximum glow spread at peak pulse, in pixels (e.g. 35).",
    "menuGlowBlur": "Base blur radius for the glow, in pixels (e.g. 8).",
    "forceCardStyling": "Apply theme colors and animations to card content, buttons (Show Answer, Again, etc.). Only affects display, doesn't modify your cards permanently.",
}


class ColorButton(QPushButton):  # type: ignore
    """A modern color picker button with live swatch and hex label.

    - Click to open the color dialog
    - Shows current hex as button text
    - Right-click to reset to default
    """

    def __init__(self, key: str, initial_hex: str, on_change, parent: QWidget | None = None) -> None:  # type: ignore
        super().__init__(parent)
        from aqt.qt import QColor  # local import in Anki runtime
        self._key = key
        self._on_change = on_change
        self._color = QColor(initial_hex) if initial_hex else QColor("#000000")  # type: ignore
        # Qt5/Qt6 compatible pointing hand cursor
        try:
            self.setCursor(Qt.PointingHandCursor)  # Qt5 style
        except Exception:
            try:
                self.setCursor(Qt.CursorShape.PointingHandCursor)  # Qt6 style
            except Exception:
                pass
        self.setMinimumHeight(28)
        self.setMaximumWidth(220)
        self._update_visuals()
        self.clicked.connect(self._pick_color)  # type: ignore

    def _hex(self) -> str:
        return self._color.name().upper()  # type: ignore

    def _best_text_color(self) -> str:
        r, g, b = self._color.red(), self._color.green(), self._color.blue()  # type: ignore
        yiq = (r * 299 + g * 587 + b * 114) / 1000
        return "#000000" if yiq > 160 else "#FFFFFF"

    def _update_visuals(self) -> None:
        hexv = self._hex()
        fg = self._best_text_color()
        self.setText(hexv)
        self.setStyleSheet(
            f"QPushButton {{ background-color: {hexv}; color: {fg}; border: 1px solid #666; border-radius: 6px; padding: 6px 10px; }}"
        )
        tech = TECH_LABELS.get(self._key, self._key)
        help_text = FIELD_HELP.get(self._key, "")
        tt = f"{tech} ({self._key}) — {help_text}".strip()
        self.setToolTip(tt)

    def _pick_color(self) -> None:
        from aqt.qt import QColorDialog  # type: ignore
        c = QColorDialog.getColor(self._color, self.window(), "Choose color")  # type: ignore
        if c and c.isValid():  # type: ignore
            self._color = c
            self._update_visuals()
            try:
                self._on_change(self._key, self._hex())
            except Exception:
                pass

    def contextMenuEvent(self, event) -> None:  # type: ignore
        menu = QMenu(self)
        reset = menu.addAction("Reset to default")
        act = menu.exec_(event.globalPos())
        if act == reset:
            default = _DEFAULTS.get(self._key)
            if isinstance(default, str):
                self.set_hex(default)
                try:
                    self._on_change(self._key, default)
                except Exception:
                    pass

    def set_hex(self, hexv: str) -> None:
        from aqt.qt import QColor  # type: ignore
        c = QColor(hexv)
        if c and c.isValid():  # type: ignore
            self._color = c
            self._update_visuals()


class ThemeDesignerDialog(QDialog):  # type: ignore
    """Dialog for editing theme configuration with user-friendly labels.

    Live preview has been removed for simplicity; use Apply/Save to see changes.
    """

    def __init__(self, parent: QWidget | None = None) -> None:  # type: ignore
        super().__init__(parent)
        self.setWindowTitle(f"{ADDON_NAME} - Theme Designer")
        self.resize(700, 650)
        self.cfg = load_config().copy()
        self._controls: Dict[str, QWidget] = {}
        self._building_ui = True
        self._setup_ui()
        self._building_ui = False

    def _setup_ui(self) -> None:
        main_layout = QVBoxLayout(self)
        
        # Preset management section at the top
        preset_group = QWidget()
        preset_layout = QVBoxLayout(preset_group)
        preset_layout.addWidget(QLabel("<b>Preset Management</b>"))
        
        preset_controls = QHBoxLayout()
        
        # Preset selector
        from aqt.qt import QComboBox  # type: ignore
        self.preset_combo = QComboBox()
        self._refresh_preset_list()
        preset_controls.addWidget(QLabel("Preset:"))
        preset_controls.addWidget(self.preset_combo)
        
        # Load preset button
        load_preset_btn = QPushButton("Load")
        load_preset_btn.setToolTip("Load the selected preset into the editor")
        load_preset_btn.clicked.connect(self._load_preset_from_combo)  # type: ignore
        preset_controls.addWidget(load_preset_btn)
        
        # Save as new preset button
        save_preset_btn = QPushButton("Save As...")
        save_preset_btn.setToolTip("Save current settings as a new preset")
        save_preset_btn.clicked.connect(self._save_as_new_preset)  # type: ignore
        preset_controls.addWidget(save_preset_btn)
        
        # Update existing preset button
        update_preset_btn = QPushButton("Update")
        update_preset_btn.setToolTip("Update the selected custom preset with current settings")
        update_preset_btn.clicked.connect(self._update_existing_preset)  # type: ignore
        preset_controls.addWidget(update_preset_btn)
        
        # Delete preset button
        delete_preset_btn = QPushButton("Delete")
        delete_preset_btn.setToolTip("Delete the selected custom preset")
        delete_preset_btn.clicked.connect(self._delete_preset)  # type: ignore
        preset_controls.addWidget(delete_preset_btn)
        
        preset_layout.addLayout(preset_controls)
        main_layout.addWidget(preset_group)
        
        # Add separator
        from aqt.qt import QFrame  # type: ignore
        separator = QFrame()
        try:
            # Qt6 style
            separator.setFrameShape(QFrame.Shape.HLine)  # type: ignore
            separator.setFrameShadow(QFrame.Shadow.Sunken)  # type: ignore
        except AttributeError:
            # Qt5 fallback
            separator.setFrameShape(QFrame.HLine)  # type: ignore
            separator.setFrameShadow(QFrame.Sunken)  # type: ignore
        main_layout.addWidget(separator)
        
        # Controls only (preview removed)
        left_widget = QWidget()
        left_layout = QVBoxLayout(left_widget)
        left_widget.setMaximumWidth(520)
        
        from aqt.qt import QScrollArea  # type: ignore
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        form_widget = QWidget()
        form = QFormLayout(form_widget)
        
        # Build editable controls with friendly labels + tooltips.
        from aqt.qt import QFileDialog, QComboBox  # type: ignore
        from aqt.qt import QInputDialog  # type: ignore
        FONT_CHOICES = [
            "System Default",
            "Inter",
            "Segoe UI",
            "Roboto",
            "Arial",
            "Noto Sans",
            "Georgia (Serif)",
            "Custom...",
        ]

        for label, key, kind in EDITABLE_FIELDS:
            if kind == "separator":
                sep_label = QLabel(f"<b>{label}</b>")
                form.addRow(sep_label)
                continue
            val = str(self.cfg.get(key, _DEFAULTS.get(key, "")))
            friendly_label = label
            tech = TECH_LABELS.get(key or "", "")
            help_text = FIELD_HELP.get(key or "", "")
            tooltip_text = (tech + (" — " + help_text if help_text else "")).strip()
            if kind == "color":
                color_btn = ColorButton(key or "", val, self.on_field_changed, self)
                self._controls[key] = color_btn
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    lbl.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                    color_btn.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                form.addRow(lbl, color_btn)
            elif kind == "image":
                # Background image picker with dropdown for backgrounds folder
                container_widget = QWidget()
                container_layout = QVBoxLayout(container_widget)
                container_layout.setContentsMargins(0, 0, 0, 0)
                
                # Dropdown + browse button row
                row1 = QHBoxLayout()
                image_combo = QComboBox()
                
                # Populate with images from backgrounds folder
                backgrounds_folder = ADDON_DIR / "backgrounds"
                image_combo.addItem("(None)", "")
                if backgrounds_folder.exists():
                    for img_file in sorted(backgrounds_folder.glob("*")):
                        if img_file.suffix.lower() in [".png", ".jpg", ".jpeg", ".webp", ".gif"]:
                            image_combo.addItem(img_file.name, str(img_file))
                
                # Add Browse option at the end
                image_combo.addItem("Browse...", "__BROWSE__")
                
                # Set current value - match by filename or path
                if val:
                    # Try exact match first
                    idx = image_combo.findData(val)
                    if idx < 0:
                        # Try matching by filename only
                        filename = Path(val).name
                        for i in range(image_combo.count()):
                            item_data = image_combo.itemData(i)
                            if item_data and item_data != "__BROWSE__" and Path(str(item_data)).name == filename:
                                idx = i
                                break
                    if idx >= 0:
                        image_combo.setCurrentIndex(idx)
                
                def on_image_combo_change(k=key, combo=image_combo):
                    def _change():
                        selected = combo.currentData()
                        if selected == "__BROWSE__":
                            # Open file browser starting from backgrounds folder
                            start_path = str(ADDON_DIR / "backgrounds")
                            fp, _ = QFileDialog.getOpenFileName(
                                self, 
                                "Choose Background Image", 
                                start_path, 
                                "Images (*.png *.jpg *.jpeg *.webp *.gif)"
                            )  # type: ignore
                            if fp:
                                # Check if file is in backgrounds folder
                                fp_path = Path(fp)
                                if fp_path.parent == backgrounds_folder:
                                    # Find it in the combo
                                    idx = combo.findData(fp)
                                    if idx >= 0:
                                        combo.setCurrentIndex(idx)
                                    else:
                                        # Add to combo (shouldn't happen but just in case)
                                        combo.insertItem(combo.count() - 1, fp_path.name, fp)
                                        combo.setCurrentIndex(combo.count() - 2)
                                else:
                                    # File is outside backgrounds folder, add as custom entry
                                    combo.insertItem(combo.count() - 1, f"Custom: {fp_path.name}", fp)
                                    combo.setCurrentIndex(combo.count() - 2)
                                self.on_field_changed(k, fp)
                            else:
                                # User cancelled, revert to previous selection
                                if val:
                                    idx = combo.findData(val)
                                    if idx >= 0:
                                        combo.setCurrentIndex(idx)
                                    else:
                                        combo.setCurrentIndex(0)
                                else:
                                    combo.setCurrentIndex(0)
                        else:
                            self.on_field_changed(k, selected or "")
                    return _change
                
                image_combo.currentIndexChanged.connect(on_image_combo_change())  # type: ignore
                
                row1.addWidget(image_combo)
                container_layout.addLayout(row1)
                
                # Disclaimer label
                disclaimer = QLabel("⚠️ For best quality, use 2560x1440 images to prevent scaling issues.")
                disclaimer.setStyleSheet("color: #ff9800; font-size: 11px; font-style: italic;")
                disclaimer.setWordWrap(True)
                container_layout.addWidget(disclaimer)
                
                self._controls[key] = image_combo
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    tt = f"{tech} ({key}) — {help_text}" if key else tooltip_text
                    lbl.setToolTip(tt)
                    image_combo.setToolTip(tt)
                form.addRow(lbl, container_widget)
            elif kind == "slider":
                # Slider for opacity/transparency
                container_widget = QWidget()
                slider_layout = QHBoxLayout(container_widget)
                slider_layout.setContentsMargins(0, 0, 0, 0)
                
                from aqt.qt import QSlider  # type: ignore
                slider = QSlider(Qt.Orientation.Horizontal if hasattr(Qt, 'Orientation') else Qt.Horizontal)  # type: ignore
                slider.setMinimum(0)
                slider.setMaximum(100)
                slider.setValue(int(float(val) * 100))
                slider.setTickPosition(QSlider.TickPosition.TicksBelow if hasattr(QSlider, 'TickPosition') else QSlider.TicksBelow)  # type: ignore
                slider.setTickInterval(10)
                
                value_label = QLabel(f"{int(float(val) * 100)}%")
                value_label.setMinimumWidth(45)
                value_label.setStyleSheet("font-weight: bold;")
                
                def on_slider_change(k=key, s=slider, lbl=value_label):
                    def _change():
                        pct = s.value()
                        lbl.setText(f"{pct}%")
                        self.on_field_changed(k, pct / 100.0)
                    return _change
                
                slider.valueChanged.connect(on_slider_change())  # type: ignore
                
                slider_layout.addWidget(slider)
                slider_layout.addWidget(value_label)
                
                self._controls[key] = slider
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    tt = f"{tech} ({key}) — {help_text}" if key else tooltip_text
                    lbl.setToolTip(tt)
                    slider.setToolTip(tt)
                form.addRow(lbl, container_widget)
            elif kind == "checkbox":
                from aqt.qt import QCheckBox  # type: ignore
                checkbox = QCheckBox()
                checkbox.setChecked(bool(self.cfg.get(key, False)))
                # Qt checkbox: 0=unchecked, 2=checked; convert to bool properly
                checkbox.stateChanged.connect(lambda state, k=key: self.on_field_changed(k, state == 2))  # type: ignore
                self._controls[key] = checkbox
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    lbl.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                    checkbox.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                lbl_widget = QWidget()
                lbl_layout = QHBoxLayout(lbl_widget)
                lbl_layout.setContentsMargins(0, 0, 0, 0)
                lbl_layout.addWidget(checkbox)
                lbl_layout.addWidget(QLabel(friendly_label))
                lbl_layout.addStretch()
                form.addRow("", lbl_widget)
            elif key == "fontFamily":
                combo = QComboBox()
                combo.addItems(FONT_CHOICES)
                # Determine initial selection
                current_val = val
                normalized_default = _DEFAULTS.get("fontFamily", "")
                if current_val == normalized_default:
                    combo.setCurrentText("System Default")
                elif any(f for f in FONT_CHOICES if f.lower() in current_val.lower().split(',')):  # simple heuristic
                    # choose first matching
                    for f in FONT_CHOICES:
                        if f == "Custom...":
                            continue
                        if f.lower() in current_val.lower():
                            combo.setCurrentText(f)
                            break
                else:
                    combo.addItem(current_val)  # show custom existing
                    combo.setCurrentText(current_val)

                def on_font_change():
                    chosen = combo.currentText()
                    if chosen == "System Default":
                        self.on_field_changed("fontFamily", normalized_default)
                    elif chosen == "Custom...":
                        text, ok = QInputDialog.getText(self, "Custom Font Family", "Enter CSS font-family value:")  # type: ignore
                        if ok and text.strip():
                            combo.addItem(text.strip())
                            combo.setCurrentText(text.strip())
                            self.on_field_changed("fontFamily", text.strip())
                        else:
                            combo.setCurrentText("System Default")
                            self.on_field_changed("fontFamily", normalized_default)
                    else:
                        # direct mapping to chosen name with fallbacks
                        fallback = "Segoe UI, Arial, sans-serif"
                        fam = {
                            "Inter": "Inter, " + fallback,
                            "Segoe UI": "Segoe UI, " + fallback,
                            "Roboto": "Roboto, " + fallback,
                            "Arial": "Arial, sans-serif",
                            "Noto Sans": "'Noto Sans', " + fallback,
                            "Georgia (Serif)": "Georgia, serif",
                        }.get(chosen, normalized_default)
                        self.on_field_changed("fontFamily", fam)

                combo.currentIndexChanged.connect(on_font_change)  # type: ignore
                self._controls[key] = combo
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    lbl.setToolTip(f"{tech} ({key}) — {help_text}")
                    combo.setToolTip(f"{tech} ({key}) — {help_text}")
                form.addRow(lbl, combo)
            else:
                line = QLineEdit(val)
                line.textChanged.connect(lambda v, k=key: self.on_field_changed(k, v))  # type: ignore
                self._controls[key] = line
                lbl = QLabel(friendly_label)
                if tooltip_text:
                    lbl.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                    line.setToolTip(f"{tech} ({key}) — {help_text}" if key else tooltip_text)
                form.addRow(lbl, line)
        
        scroll.setWidget(form_widget)
        left_layout.addWidget(QLabel("<b>Theme Settings</b>"))
        left_layout.addWidget(scroll)
        main_layout.addWidget(left_widget)

        # Action buttons
        btn_row = QHBoxLayout()
        apply_btn = QPushButton("Apply")
        save_btn = QPushButton("Save")
        reset_btn = QPushButton("Reset Defaults")
        close_btn = QPushButton("Close")
        apply_btn.clicked.connect(self.apply_without_save)  # type: ignore
        save_btn.clicked.connect(self.save_and_apply)  # type: ignore
        reset_btn.clicked.connect(self.reset_defaults)  # type: ignore
        close_btn.clicked.connect(self.close)  # type: ignore
        btn_row.addWidget(apply_btn)
        btn_row.addWidget(save_btn)
        btn_row.addWidget(reset_btn)
        btn_row.addStretch(1)
        btn_row.addWidget(close_btn)
        main_layout.addLayout(btn_row)

    # ------------- Preset Management Methods ------------- #
    def _refresh_preset_list(self) -> None:
        """Refresh the preset combo box with all presets."""
        if not hasattr(self, 'preset_combo'):
            return
        
        current_text = self.preset_combo.currentText()
        self.preset_combo.clear()
        
        all_presets = get_all_presets()
        
        # Add built-in presets first
        for name in sorted(THEME_PRESETS.keys()):
            self.preset_combo.addItem(f"🔒 {name}", name)
        
        # Add custom presets
        custom = load_custom_presets()
        if custom:
            for name in sorted(custom.keys()):
                self.preset_combo.addItem(f"✨ {name}", name)
        
        # Restore selection if possible
        if current_text:
            idx = self.preset_combo.findText(current_text)
            if idx >= 0:
                self.preset_combo.setCurrentIndex(idx)
    
    def _load_preset_from_combo(self) -> None:
        """Load the selected preset into the editor."""
        if not hasattr(self, 'preset_combo'):
            return
        
        preset_name = self.preset_combo.currentData()
        if not preset_name:
            return
        
        all_presets = get_all_presets()
        if preset_name not in all_presets:
            tooltip("Preset not found!", period=1500)  # type: ignore
            return
        
        preset = all_presets[preset_name]
        
        # Update internal config
        self.cfg = {**self.cfg, **preset}
        
        # Update all UI controls
        self._building_ui = True
        for _, key, kind in EDITABLE_FIELDS:
            if not key:
                continue
            ctrl = self._controls.get(key)
            if not ctrl:
                continue
            
            value = self.cfg.get(key, _DEFAULTS.get(key, ""))
            
            if isinstance(ctrl, QLineEdit):
                ctrl.setText(str(value))
            elif hasattr(ctrl, "set_hex"):  # ColorButton
                try:
                    ctrl.set_hex(str(value))  # type: ignore
                except Exception:
                    pass
            elif kind == "checkbox":
                from aqt.qt import QCheckBox  # type: ignore
                if isinstance(ctrl, QCheckBox):
                    ctrl.setChecked(bool(value))
            elif kind == "slider":
                from aqt.qt import QSlider  # type: ignore
                if isinstance(ctrl, QSlider):
                    ctrl.setValue(int(float(value) * 100))
            elif kind == "image":
                from aqt.qt import QComboBox  # type: ignore
                if isinstance(ctrl, QComboBox):
                    # Handle both full paths and just filenames
                    val_str = str(value)
                    if val_str:
                        # Try exact match first
                        idx = ctrl.findData(val_str)
                        if idx < 0:
                            # Try matching by filename only
                            filename = Path(val_str).name
                            for i in range(ctrl.count()):
                                item_data = ctrl.itemData(i)
                                if item_data and Path(str(item_data)).name == filename:
                                    idx = i
                                    break
                        if idx >= 0:
                            ctrl.setCurrentIndex(idx)
                            # If loading a preset with a background image, set opacity to 50% if not already set
                            if value and key == "webviewBackgroundImage":
                                opacity_key = "webviewBackgroundImageOpacity"
                                if opacity_key not in preset or preset.get(opacity_key) == 1.0:
                                    self.cfg[opacity_key] = 0.5
                                    # Update opacity slider if it exists
                                    opacity_ctrl = self._controls.get(opacity_key)
                                    if opacity_ctrl:
                                        from aqt.qt import QSlider  # type: ignore
                                        if isinstance(opacity_ctrl, QSlider):
                                            opacity_ctrl.setValue(50)
                        else:
                            ctrl.setCurrentIndex(0)  # None
                    else:
                        ctrl.setCurrentIndex(0)  # None
            elif kind == "fontFamily":
                from aqt.qt import QComboBox  # type: ignore
                if isinstance(ctrl, QComboBox):
                    # Try to match font family
                    font_val = str(value)
                    if "Inter" in font_val:
                        ctrl.setCurrentText("Inter")
                    elif "Roboto" in font_val:
                        ctrl.setCurrentText("Roboto")
                    elif "Georgia" in font_val:
                        ctrl.setCurrentText("Georgia (Serif)")
                    elif "Comic Sans" in font_val:
                        ctrl.setCurrentText("Comic Sans MS")
                    else:
                        ctrl.setCurrentText("System Default")
        
        self._building_ui = False
        tooltip(f"Loaded preset: {preset_name}", period=2000)  # type: ignore
    
    def _save_as_new_preset(self) -> None:
        """Save current settings as a new preset."""
        from aqt.qt import QInputDialog  # type: ignore
        
        name, ok = QInputDialog.getText(
            self,
            "Save Preset",
            "Enter preset name:",
            text="My Custom Theme"
        )
        
        if not ok or not name or not name.strip():
            return
        
        name = name.strip()
        
        # Check if overwriting built-in
        if is_builtin_preset(name):
            from aqt.utils import askUser  # type: ignore
            if not askUser(
                f"'{name}' is a built-in preset. Your custom version will override it in the menu.\n\nContinue?",
                parent=self,
                title="Override Built-in Preset?"
            ):
                return
        
        # Check if overwriting existing custom
        custom = load_custom_presets()
        if name in custom:
            from aqt.utils import askUser  # type: ignore
            if not askUser(
                f"Preset '{name}' already exists.\n\nOverwrite it?",
                parent=self,
                title="Overwrite Preset?"
            ):
                return
        
        if save_current_as_preset(name, self.cfg):
            self._refresh_preset_list()
            # Select the newly saved preset
            idx = self.preset_combo.findData(name)
            if idx >= 0:
                self.preset_combo.setCurrentIndex(idx)
            # Rebuild menu to show new preset
            rebuild_beautify_menu()
            tooltip(f"Preset '{name}' saved!", period=2000)  # type: ignore
        else:
            tooltip("Failed to save preset!", period=1500)  # type: ignore
    
    def _update_existing_preset(self) -> None:
        """Update the selected preset with current settings."""
        if not hasattr(self, 'preset_combo'):
            return
        
        preset_name = self.preset_combo.currentData()
        if not preset_name:
            tooltip("No preset selected!", period=1500)  # type: ignore
            return
        
        # Cannot update built-in presets
        if is_builtin_preset(preset_name) and preset_name not in load_custom_presets():
            tooltip("Cannot update built-in presets! Use 'Save As...' instead.", period=2000)  # type: ignore
            return
        
        from aqt.utils import askUser  # type: ignore
        if not askUser(
            f"Update preset '{preset_name}' with current settings?",
            parent=self,
            title="Update Preset?"
        ):
            return
        
        # Update the custom config
        self.cfg["fontFamily"] = str(self.cfg.get("fontFamily", _DEFAULTS["fontFamily"]))
        self.cfg["cardFontSize"] = str(self.cfg.get("cardFontSize", _DEFAULTS["cardFontSize"]))
        
        if save_current_as_preset(preset_name, self.cfg):
            # Rebuild menu in case preset name changed
            rebuild_beautify_menu()
            tooltip(f"Preset '{preset_name}' updated!", period=2000)  # type: ignore
        else:
            tooltip("Failed to update preset!", period=1500)  # type: ignore
    
    def _delete_preset(self) -> None:
        """Delete the selected custom preset."""
        if not hasattr(self, 'preset_combo'):
            return
        
        preset_name = self.preset_combo.currentData()
        if not preset_name:
            tooltip("No preset selected!", period=1500)  # type: ignore
            return
        
        # Cannot delete built-in presets
        if is_builtin_preset(preset_name) and preset_name not in load_custom_presets():
            tooltip("Cannot delete built-in presets!", period=1500)  # type: ignore
            return
        
        from aqt.utils import askUser  # type: ignore
        if not askUser(
            f"Delete preset '{preset_name}'?\n\nThis cannot be undone.",
            parent=self,
            title="Delete Preset?"
        ):
            return
        
        if delete_custom_preset(preset_name):
            self._refresh_preset_list()
            # Rebuild menu to remove deleted preset
            rebuild_beautify_menu()
            tooltip(f"Preset '{preset_name}' deleted!", period=2000)  # type: ignore
        else:
            tooltip("Failed to delete preset!", period=1500)  # type: ignore

    # ------------- Field & Config Handling ------------- #
    def on_field_changed(self, key: str, value: any) -> None:
        if self._building_ui:
            return
        # Handle different value types properly
        if isinstance(value, bool):
            self.cfg[key] = value
        elif isinstance(value, (int, float)):
            self.cfg[key] = value
        else:
            self.cfg[key] = str(value)
        # Only update in-memory config; apply on Apply/Save.

    def update_preview(self, live: bool = False) -> None:
        # Preview removed; no-op for compatibility.
        return

    def _apply_global_temp(self) -> None:
        global _config_cache
        # Ensure self.cfg overrides cached values completely
        _config_cache = {**(_config_cache or {}), **self.cfg}
        apply_global_stylesheet()
        # Force deck browser reload if visible
        if mw and mw.state == "deckBrowser":
            try:
                mw.moveToState("deckBrowser")
            except Exception:
                pass

    def apply_without_save(self) -> None:
        self._apply_global_temp()
        tooltip("Theme applied (not saved). Return to deck browser to see changes.", period=2500)  # type: ignore

    def save_and_apply(self) -> None:
        # Persist to Anki's config system
        try:
            if mw and hasattr(mw, "addonManager"):
                save_blob = {k: self.cfg.get(k) for k in _DEFAULTS.keys()}
                mw.addonManager.writeConfig(ADDON_ID, save_blob)  # type: ignore
        except Exception:
            pass
        reload_config()  # repopulates cache
        apply_global_stylesheet()
        # Force deck browser reload
        if mw and mw.state == "deckBrowser":
            try:
                mw.moveToState("deckBrowser")
            except Exception:
                pass
        tooltip("Theme saved & applied. Return to deck browser to see changes.", period=2500)  # type: ignore

    def reset_defaults(self) -> None:
        self.cfg = _DEFAULTS.copy()
        for _, key, kind in EDITABLE_FIELDS:
            ctrl = self._controls.get(key)
            if isinstance(ctrl, QLineEdit):
                ctrl.setText(str(self.cfg[key]))
            elif ctrl and hasattr(ctrl, "set_hex"):
                try:
                    ctrl.set_hex(str(self.cfg[key]))  # type: ignore
                except Exception:
                    pass
            elif kind == "checkbox":
                from aqt.qt import QCheckBox  # type: ignore
                if isinstance(ctrl, QCheckBox):
                    ctrl.setChecked(bool(self.cfg[key]))
        # No live preview; keep UI values only.
        tooltip("Defaults restored (not saved).", period=2000)  # type: ignore


def open_theme_designer_dialog() -> None:
    """Open the Theme Designer dialog."""
    if not mw:
        return
    dlg = ThemeDesignerDialog(mw)  # type: ignore
    dlg.show()


def open_style_guide() -> None:
    """Show a simple style guide explaining what each setting affects."""
    if not mw:
        return
    try:
        d = QDialog(mw)  # type: ignore
        d.setWindowTitle(f"{ADDON_NAME} - Style Guide")
        d.resize(640, 520)
        v = QVBoxLayout(d)
        txt = QLabel(
            """
            <h3>What gets styled and how</h3>
            <p><b>Anki has TWO UI systems:</b></p>
            <ol>
              <li><b>Qt Widgets</b> (native controls): menus, toolbars, dialogs, buttons, inputs</li>
              <li><b>Webviews</b> (HTML/CSS/JS): deck browser, overview, review cards, congrats screen</li>
            </ol>
            <h4>Qt Widget Colors (affect native UI)</h4>
            <ul>
              <li><b>Window Background</b>: Main window and dialog backgrounds</li>
              <li><b>Panel/Toolbar Background</b>: Toolbars, menus, sidebar panels</li>
              <li><b>Text Color</b>: Primary text in Qt widgets</li>
              <li><b>Muted Text</b>: Secondary/disabled text</li>
              <li><b>Accent/Focus</b>: Hover states, selected items, focus rings</li>
              <li><b>Danger/Success</b>: Warning/success indicators</li>
              <li><b>Border Color</b>: Qt widget borders</li>
            </ul>
            <h4>Webview Colors (affect HTML screens)</h4>
            <ul>
              <li><b>Webview Background</b>: Page background for deck browser & overview</li>
              <li><b>Webview Canvas</b>: Deck list tables and card containers</li>
              <li><b>Webview Text/Links</b>: Text and links in HTML screens</li>
              <li><b>Deck Hover</b>: Deck row hover highlight</li>
              <li><b>Gradient Start/End</b>: Review card screen background gradient</li>
              <li><b>Card Background</b>: Semi-transparent card container in reviewer</li>
            </ul>
            <p><b>Still not styled?</b> Some areas use custom components. Use <b>extraGlobalCss</b> (Qt widgets),
            <b>extraWebviewCss</b> (deck browser/overview), or <b>extraReviewerCss</b> (cards) for overrides.</p>
            """
        )
        txt.setWordWrap(True)
        v.addWidget(txt)
        btn = QPushButton("Close")
        btn.clicked.connect(d.close)  # type: ignore
        v.addWidget(btn)
        d.show()
    except Exception:
        tooltip("Could not open style guide.")  # type: ignore


def rebuild_beautify_menu() -> None:
    """Remove and rebuild the Design menu (for updating preset list)."""
    if not mw or not hasattr(mw, "form"):
        return
    try:
        menubar = mw.form.menubar  # type: ignore
        # Remove existing menu
        for act in menubar.actions():
            if act.text() == "Design":
                menubar.removeAction(act)
                break
        # Rebuild
        add_beautify_menu()
    except Exception:
        pass


def add_beautify_menu() -> None:
    """Insert a top-level 'Design' menu into the menubar with actions."""
    if not mw or not hasattr(mw, "form"):
        return
    try:
        menubar = mw.form.menubar  # type: ignore
        # Avoid duplicate menu creation on reload.
        for act in menubar.actions():
            if act.text() == "Design":
                return
        beautify_menu = QMenu("Design", mw)  # type: ignore
        # Insert before Help menu if available.
        help_action = getattr(mw.form, "menuHelp", None)  # type: ignore
        if help_action and hasattr(help_action, "menuAction"):
            menubar.insertMenu(help_action.menuAction(), beautify_menu)  # type: ignore
        else:
            menubar.addMenu(beautify_menu)  # type: ignore
        
        beautify_menu.addAction("Theme Designer...", open_theme_designer_dialog)  # type: ignore
        beautify_menu.addAction("Style Guide", open_style_guide)  # type: ignore
        beautify_menu.addSeparator()  # type: ignore
        
        # Force Card Styling toggle
        cfg = load_config()
        card_styling_action = beautify_menu.addAction("✓ Force Theme to Card Content" if cfg.get("forceCardStyling", False) else "☐ Force Theme to Card Content")  # type: ignore
        card_styling_action.triggered.connect(_toggle_card_styling)  # type: ignore
        beautify_menu.addSeparator()  # type: ignore
        
        # Presets submenu
        presets_menu = beautify_menu.addMenu("🎨 Presets")  # type: ignore
        
        # Built-in presets
        for preset_name in sorted(THEME_PRESETS.keys()):
            presets_menu.addAction(f"🔒 {preset_name}", lambda p=preset_name: apply_preset(p))  # type: ignore
        
        # Custom presets (if any)
        custom_presets = load_custom_presets()
        if custom_presets:
            presets_menu.addSeparator()  # type: ignore
            for preset_name in sorted(custom_presets.keys()):
                presets_menu.addAction(f"✨ {preset_name}", lambda p=preset_name: apply_preset(p))  # type: ignore
        
        beautify_menu.addSeparator()  # type: ignore
        beautify_menu.addAction("Reload Theme", lambda: (refresh_theme(), tooltip("Theme reloaded. Deck browser refreshed.", period=2000)))  # type: ignore
        beautify_menu.addAction("Reset to Defaults", lambda: (_write_defaults_and_reload(), tooltip("Defaults saved & applied", period=1800)))  # type: ignore
    except Exception:
        pass


def _open_url(url: str) -> None:
    """Open URL in system default browser."""
    try:
        import webbrowser
        webbrowser.open(url)
    except Exception:
        pass


def _toggle_card_styling() -> None:
    """Toggle forceCardStyling setting and refresh."""
    try:
        cfg = load_config()
        current = cfg.get("forceCardStyling", False)
        new_value = not current
        
        if mw and hasattr(mw, "addonManager"):
            cfg["forceCardStyling"] = new_value
            mw.addonManager.writeConfig(ADDON_ID, cfg)  # type: ignore
        
        reload_config()
        
        # Rebuild menu to update checkmark
        menubar = mw.form.menubar  # type: ignore
        for act in menubar.actions():
            if act.text() == "Design":
                menubar.removeAction(act)
                break
        add_beautify_menu()
        
        status = "enabled" if new_value else "disabled"
        tooltip(f"Card content theming {status}. Review a card to see changes.", period=2500)  # type: ignore
    except Exception:
        pass


def _write_defaults_and_reload() -> None:
    try:
        if mw and hasattr(mw, "addonManager"):
            mw.addonManager.writeConfig(ADDON_ID, {k: v for k, v in _DEFAULTS.items()})  # type: ignore
        reload_config()
        apply_global_stylesheet()
    except Exception:
        pass

# Ensure menu appears after profile load.
def _post_profile_menu() -> None:
    add_beautify_menu()

if gui_hooks:
    try:
        gui_hooks.profile_did_open.append(_post_profile_menu)
    except Exception:
        pass

__all__ = [
    "load_config",
    "reload_config",
    "apply_global_stylesheet",
    "inject_webview_css",
    "refresh_theme",
]
