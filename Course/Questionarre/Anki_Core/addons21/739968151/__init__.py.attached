def _build_webview_glow_css(cfg: Dict[str, Any]) -> str:
    """Build webview glow animation CSS if menu glow is enabled."""
    if not cfg.get("menuGlowEnabled", False):
        return ""
    color = cfg.get("menuGlowColor", "#00ffff")
    speed = float(cfg.get("menuGlowSpeed", 2.0) or 2.0)
    intensity = int(cfg.get("menuGlowIntensity", 35) or 35)
    blur = int(cfg.get("menuGlowBlur", 8) or 8)
    # Webview glow slightly softer than Qt
    base_blur = blur - 2
    mid_blur = int(intensity * 0.5)
    peak_blur = int(intensity * 0.8)
    return f"""
/* Webview Glow Effect */
@keyframes webviewGlowPulse {{
    0%, 100% {{ box-shadow: 0 0 {base_blur}px {color} !important; }}
    50% {{ box-shadow: 0 0 {mid_blur}px {color}, 0 0 {peak_blur}px {color} !important; }}
}}
table {{
    box-shadow: 0 0 {base_blur}px {color} !important;
    animation: webviewGlowPulse {speed * 1.5}s ease-in-out infinite !important;
}}
button {{
    box-shadow: 0 0 {base_blur - 1}px {color} !important;
}}
button:hover {{
    box-shadow: 0 0 {mid_blur - 5}px {color}, 0 0 {mid_blur}px {color} !important;
}}
"""

def _rgba_from_hex(hex_color: str, alpha: float) -> str:
    """Convert a hex color like #RRGGBB to rgba(r,g,b,a) string.

    Falls back to black if parsing fails.
    """
    try:
        s = hex_color.strip()
        if s.startswith('#'):
            s = s[1:]
        if len(s) == 3:  # shorthand #rgb
            r = int(s[0] * 2, 16)
            g = int(s[1] * 2, 16)
            b = int(s[2] * 2, 16)
        elif len(s) >= 6:
            r = int(s[0:2], 16)
            g = int(s[2:4], 16)
            b = int(s[4:6], 16)
        else:
            r, g, b = 0, 0, 0
        # Clamp alpha
        a = 0.0 if alpha < 0 else (1.0 if alpha > 1 else alpha)
        return f"rgba({r},{g},{b},{a})"
    except Exception:
        a = 0.0 if alpha < 0 else (1.0 if alpha > 1 else alpha)
        return f"rgba(0,0,0,{a})"


def _hex_to_rgb(hex_color: str) -> Tuple[int, int, int]:
    """Parse a hex color string into an RGB tuple.

    Returns (0,0,0) on failure.
    """
    try:
        s = hex_color.strip()
        if s.startswith("#"):
            s = s[1:]
        if len(s) == 3:  # shorthand #rgb
            return (int(s[0] * 2, 16), int(s[1] * 2, 16), int(s[2] * 2, 16))
        if len(s) >= 6:
            return (int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16))
    except Exception:
        pass
    return (0, 0, 0)


def _relative_luminance(hex_color: str) -> float:
    """Compute WCAG relative luminance for a given hex color."""
    r, g, b = _hex_to_rgb(hex_color)

    def _channel(c: int) -> float:
        c_lin = c / 255.0
        return c_lin / 12.92 if c_lin <= 0.04045 else ((c_lin + 0.055) / 1.055) ** 2.4

    return 0.2126 * _channel(r) + 0.7152 * _channel(g) + 0.0722 * _channel(b)


def _is_light_color(hex_color: str) -> bool:
    """Return True if color is light based on luminance threshold."""
    try:
        return _relative_luminance(hex_color) >= 0.6
    except Exception:
        return False


def _ensure_contrast_color(bg_hex: str, fg_hex: Optional[str], *, light_fg: str = "#f7f7f7", dark_fg: str = "#111111") -> str:
    """Ensure text color contrasts with background.

    - If bg is light, prefer dark_fg.
    - If bg is dark, prefer light_fg.
    - If a user-specified fg clashes with that rule, fall back to the preferred color.
    """
    try:
        bg_is_light = _is_light_color(bg_hex)
    except Exception:
        bg_is_light = False
    preferred = dark_fg if bg_is_light else light_fg

    if not fg_hex:
        return preferred

    try:
        fg_is_light = _is_light_color(fg_hex)
    except Exception:
        return preferred

    if bg_is_light and fg_is_light:
        return dark_fg
    if (not bg_is_light) and (not fg_is_light):
        return light_fg
    return fg_hex

def build_toolbar_css(cfg: Dict[str, Any]) -> str:
    """Build CSS specifically for the top toolbar buttons.
    
    Targets Decks, Add, Browse, Stats, Sync buttons in the toolbar.
    """
    if not cfg.get("enableWebviewStyles", True):
        return ""

    toolbar_bg = cfg.get("globalBackground", "#0f0f17")
    toolbar_text = _ensure_contrast_color(toolbar_bg, cfg.get("textColor"))
    toolbar_link = _ensure_contrast_color(toolbar_bg, cfg.get("webviewForeground"))
    
    return f"""
/* {ADDON_NAME} - Toolbar Styling */

/* Force toolbar webview background */
html, body {{
    background: {toolbar_bg} !important;
    background-color: {toolbar_bg} !important;
    margin: 0px !important;
    padding: 0px !important;
    color: {toolbar_link} !important;
}}

/* Toolbar background (match menu background) */
.header {{
    background: {toolbar_bg} !important;
}}

.toolbar {{
    background: {toolbar_bg} !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 4px !important;
    padding: 2px 6px !important;
    margin: 0px !important;
}}

.toolbar * {{
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    margin: 0px !important;
    padding: 0px !important;
}}

/* All toolbar buttons - minimal styling matching background */
#decks, #add, #browse, #stats, #sync, .hitem {{
    background: transparent !important;
    color: {toolbar_text} !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 4px 10px !important;
    margin: 2px 2px !important;
    border-radius: 4px !important;
    font-weight: 500 !important;
    font-size: 13px !important;
    transition: all 0.2s ease !important;
    text-decoration: none !important;
    display: inline-block !important;
    vertical-align: middle !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    height: auto !important;
}}

/* Ensure all common elements use the foreground color for contrast */
table, tr, td, th, p, span, div, input, select, option, textarea, label {{
    color: {toolbar_link} !important;
}}

a, a.deck {{
    color: {toolbar_link} !important;
    text-decoration: none !important;
}}

a:hover, a.deck:hover {{
    color: {cfg['webviewLink']} !important;
    text-decoration: underline !important;
}}

#decks:hover, #add:hover, #browse:hover, #stats:hover, #sync:hover, .hitem:hover {{
    background: {cfg['deckHoverBackground']} !important;
    color: {cfg['accentColor']} !important;
}}

#decks:active, #add:active, #browse:active, #stats:active, #sync:active, .hitem:active {{
    background: {cfg['borderColor']} !important;
}}
"""

def build_browser_editor_css(cfg: Dict[str, Any]) -> str:
    """Build CSS specifically for Browser editor webview."""
    if not cfg.get("enableWebviewStyles", True):
        return ""
    
    # Choose a foreground that contrasts with the panel background so the
    # right-hand editor pane (fields) is always readable. For light themes
    # this evaluates to black; for dark themes, to white.
    editor_fg = _ensure_contrast_color(cfg.get('panelBackground', '#0f0f17'), cfg.get('textColor'))

    return f"""
/* {ADDON_NAME} - Browser Editor Styling */
body {{
    background: {cfg['globalBackground']} !important;
    color: {editor_fg} !important;
}}

.field {{
    background: {cfg['cardBackground']} !important;
    color: {editor_fg} !important;
    border: 1px solid {cfg['borderColor']} !important;
    border-radius: 6px !important;
}}

#fields {{
    background: {cfg['panelBackground']} !important;
    color: {editor_fg} !important;
}}

.fname {{
    color: {editor_fg} !important;
}}

/* Strong override: ensure everything in the editor inherits the readable color */
html, body, #fields, #fields * {{
    color: {editor_fg} !important;
}}

button {{
    background: {cfg['accentColor']} !important;
    color: #fff !important;
    border: none !important;
    border-radius: 6px !important;
    padding: 6px 12px !important;
}}

button:hover {{
    filter: brightness(1.1) !important;
}}
"""

def build_bottom_bar_css(cfg: Dict[str, Any]) -> str:
    """Build CSS specifically for bottom bars without background image."""
    if not cfg.get("enableWebviewStyles", True):
        return ""

    bottom_fg = _ensure_contrast_color(cfg.get("panelBackground", "#0f0f17"), cfg.get("webviewForeground"))
    bottom_btn_text = _ensure_contrast_color(cfg.get("panelBackground", "#0f0f17"), cfg.get("textColor"))
    
    return f"""
/* {ADDON_NAME} - Bottom Bar (No Background Image) */
html, body {{
    background: {cfg['panelBackground']} !important;
    background-image: none !important;
    color: {bottom_fg} !important;
    font-family: {cfg['fontFamily']} !important;
    margin: 0 !important;
    padding: 12px !important;
}}

button, input[type="button"] {{
    background: {cfg['panelBackground']} !important;
    color: {bottom_btn_text} !important;
    border: 2px solid {cfg['borderColor']} !important;
    border-radius: 8px !important;
    padding: 6px 14px !important;
    font-family: {cfg['fontFamily']} !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
}}

button:hover, input[type="button"]:hover {{
    background: {cfg['deckHoverBackground']} !important;
    border-color: {cfg['accentColor']} !important;
}}
"""


def build_webview_css(cfg: Dict[str, Any]) -> str:
    """Build CSS for HTML-based screens: deck browser, overview, congrats.
    
    Anki's deck browser, overview, and other main screens are webviews
    (HTML/CSS/JS), NOT Qt widgets. This CSS targets those screens.
    Uses !important to override Anki's default styles.
    """
    if not cfg.get("enableWebviewStyles", True):
        return ""
    
    bg_img = cfg.get("webviewBackgroundImage", "").strip()
    bg_opacity = float(cfg.get("webviewBackgroundImageOpacity", 1.0))
    bg_color = cfg['webviewBackground']

    # Resolve filename to path in backgrounds folder when needed
    if bg_img and not bg_img.startswith("data:image") and not Path(bg_img).is_absolute():
        folder_path = ADDON_DIR / "backgrounds" / bg_img
        if folder_path.exists():
            bg_img = str(folder_path)

    # Convert local file path to data URI (more reliable than file:// in QWebEngine)
    if bg_img and not bg_img.startswith("data:image"):
        try:
            p = Path(str(bg_img))
            if p.exists():
                ext = p.suffix.lower().lstrip('.')
                mime = f"image/{'jpeg' if ext in {'jpg','jpeg'} else ('png' if ext=='png' else ( 'webp' if ext=='webp' else 'png'))}"
                data = p.read_bytes()
                import base64
                b64 = base64.b64encode(data).decode('utf-8')
                bg_img = f"data:{mime};base64,{b64}"
            else:
                bg_img = ""
        except Exception:
            bg_img = ""

    # Build layered background: top = semi-transparent color (same as bg), middle = image, bottom = solid bg color
    overlay_rgba = _rgba_from_hex(bg_color, max(0.0, min(1.0, 1.0 - bg_opacity)))
    if bg_img:
        bg_css = (
            f"background-image: linear-gradient({overlay_rgba}, {overlay_rgba}), url('{bg_img}'), none !important;"
            f"background-color: {bg_color} !important;"
        )
    else:
        bg_css = f"background: {bg_color} !important;"

    # Ensure text contrasts with the chosen background/panel colors
    webview_fg = _ensure_contrast_color(bg_color, cfg.get("webviewForeground"))
    panel_text = _ensure_contrast_color(cfg.get("panelBackground", bg_color), cfg.get("textColor"))

    # Removed Pink Blossom-specific overrides

    css = f"""
/* {ADDON_NAME} - Webview Screens (Deck Browser, Overview) */
/* Background layers with light breathing room */
html, body {{
    {bg_css}
    background-size: cover, cover, auto !important;
    background-position: center center, center center, 0 0 !important;
    background-repeat: no-repeat, no-repeat, repeat !important;
    color: {webview_fg} !important;
    font-family: {cfg['fontFamily']} !important;
    margin: 0 !important;
    padding: 6px !important; /* compact spacing */
}}

/* Main table container - compact dense look */
table {{
    background: {cfg['panelBackground']} !important;
    border: 2px solid {cfg['accentColor']} !important;
    border-radius: 12px !important;
    padding: 12px !important;
    margin: 6px auto !important; /* minimal margins */
    width: 100% !important;
    max-width: 900px !important;
}}

/* Deck rows - compact spacing */
tr.deck td {{
    background: {cfg['panelBackground']} !important;
    color: {panel_text} !important;
    padding: 6px 10px !important;
    border-bottom: 1px solid {cfg['borderColor']} !important;
}}

tr.deck:hover td {{
    background: {cfg['deckHoverBackground']} !important;
}}

tr.deck.current td {{
    background: {cfg['accentColor']} !important;
    color: {'#000000' if cfg.get('accentColor', '').lower() in ['#00ffff', '#0ff'] else '#fff'} !important;
}}

/* Force dark text on current deck row when accent is bright cyan */
tr.deck.current a,
tr.deck.current a.deck,
tr.deck.current a:hover,
tr.deck.current a.deck:hover,
tr.deck.current .new-count,
tr.deck.current .learn-count,
tr.deck.current .review-count {{
    color: {'#000000' if cfg.get('accentColor', '').lower() in ['#00ffff', '#0ff'] else 'inherit'} !important;
}}

/* Deck names and links */
a, a.deck {{
    color: {webview_fg} !important;
    text-decoration: none !important;
}}

a:hover, a.deck:hover {{
    color: {cfg['webviewLink']} !important;
    text-decoration: underline !important;
}}

/* Table headers */
th {{
    color: {cfg['mutedTextColor']} !important;
    border-bottom: 1px solid {cfg['webviewBorder']} !important;
}}

/* Count badges (new/learning/review) - compact */
.new-count {{
    color: {cfg['accentColor']} !important;
    font-weight: 600 !important;
    font-size: 0.9em !important;
}}

.learn-count {{
    color: {cfg['dangerColor']} !important;
    font-weight: 600 !important;
    font-size: 0.9em !important;
}}

.review-count {{
    color: {cfg['successColor']} !important;
    font-weight: 600 !important;
    font-size: 0.9em !important;
}}

.zero-count {{
    color: {cfg['mutedTextColor']} !important;
    font-size: 0.9em !important;
}}

/* Buttons - Enhanced styling (restore) */
button, input[type="button"] {{
    background: {cfg['panelBackground']} !important;
    color: {panel_text} !important;
    border: 2px solid {cfg['borderColor']} !important;
    border-radius: 8px !important;
    padding: 6px 14px !important;
    font-family: {cfg['fontFamily']} !important;
