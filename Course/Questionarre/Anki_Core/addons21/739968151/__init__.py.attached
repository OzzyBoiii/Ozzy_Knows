# ------------------------- Custom Preset Management ------------------------- #

def get_custom_presets_path() -> Path:
    """Get path to custom presets JSON file."""
    return ADDON_DIR / "custom_presets.json"

# Alias removed per user request: Pink Blossom references are deprecated.


def load_custom_presets() -> Dict[str, Dict[str, Any]]:
    """Load custom user-created presets from disk."""
    path = get_custom_presets_path()
    if not path.exists():
        return {}
    try:
        with path.open("r", encoding="utf-8") as f:
            data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


def save_custom_presets(presets: Dict[str, Dict[str, Any]]) -> bool:
    """Save custom presets to disk."""
    path = get_custom_presets_path()
    try:
        with path.open("w", encoding="utf-8") as f:
            json.dump(presets, f, indent=2, ensure_ascii=False)
        return True
    except Exception:
        return False


def get_all_presets() -> Dict[str, Dict[str, Any]]:
    """Get all presets: built-in + custom."""
    custom = load_custom_presets()
    # Custom presets override built-in if same name (allows user to override)
    return {**THEME_PRESETS, **custom}


def save_current_as_preset(preset_name: str, config_override: Dict[str, Any] | None = None) -> bool:
    """Save current config as a custom preset.
    
    Args:
        preset_name: Name for the preset
        config_override: Optional config dict to use instead of current config
    """
    if not preset_name or not preset_name.strip():
        return False
    
    preset_name = preset_name.strip()
    
    # Prevent overriding built-in presets accidentally
    if preset_name in THEME_PRESETS:
        # Ask for confirmation (handled by UI layer)
        pass
    
    cfg = config_override if config_override else load_config()
    custom_presets = load_custom_presets()
    
    # Save all theme properties
    preset_data = {k: cfg.get(k, _DEFAULTS[k]) for k in _DEFAULTS.keys()}
    custom_presets[preset_name] = preset_data
    
    return save_custom_presets(custom_presets)


def delete_custom_preset(preset_name: str) -> bool:
    """Delete a custom preset. Cannot delete built-in presets."""
    if preset_name in THEME_PRESETS:
        return False  # Cannot delete built-in
    
    custom_presets = load_custom_presets()
    if preset_name in custom_presets:
        del custom_presets[preset_name]
        return save_custom_presets(custom_presets)
    return False


def is_builtin_preset(preset_name: str) -> bool:
    """Check if preset is a built-in (read-only) preset."""
    return preset_name in THEME_PRESETS


def apply_preset(preset_name: str) -> None:
    """Apply a theme preset by name, save to config, and refresh UI."""
    all_presets = get_all_presets()
    if preset_name not in all_presets:
        return
    preset = all_presets[preset_name]
    if mw and hasattr(mw, "addonManager"):
        try:
            mw.addonManager.writeConfig(ADDON_ID, preset)  # type: ignore
        except Exception:
            pass
    
    # Force reload config to clear cache
    reload_config()
    
    # Apply global styles
    apply_global_stylesheet()
    
    # Force toolbar to rebuild and re-inject CSS
    if mw and hasattr(mw, 'toolbar'):
        try:
            # Get the new CSS with updated colors
            toolbar_css = build_toolbar_css(load_config())
            # Inject directly into toolbar webview
            if hasattr(mw.toolbar, 'web') and hasattr(mw.toolbar.web, 'eval'):
                js_code = f"""
                (function() {{
                    let style = document.getElementById('uba-toolbar-style');
                    if (!style) {{
                        style = document.createElement('style');
                        style.id = 'uba-toolbar-style';
                        document.head.appendChild(style);
                    }}
                    style.textContent = `{toolbar_css.replace('`', '\\`').replace('\\', '\\\\')}`;
                }})();
                """
                mw.toolbar.web.eval(js_code)
        except Exception as e:
            pass
    
    # Force deck browser reload
    if mw and mw.state == "deckBrowser":
        try:
            # Use a slight delay to ensure config is written
            from aqt.qt import QTimer  # type: ignore
            QTimer.singleShot(100, lambda: mw.moveToState("deckBrowser"))
        except Exception:
            pass
    
    from aqt.utils import tooltip  # type: ignore
    tooltip(f"{preset_name} theme applied!", period=2000)  # type: ignore

# ------------------------- Config Handling ------------------------- #

def load_config() -> Dict[str, Any]:
    """Load config using Anki's addon manager with safe fallbacks.

    Returns:
        A dictionary containing config values merged with defaults.
    """
    global _config_cache
    if _config_cache is not None:
        return _config_cache

    data: Dict[str, Any] = {}
    if mw and hasattr(mw, "addonManager"):
        try:
            loaded = mw.addonManager.getConfig(ADDON_ID)  # type: ignore
            if isinstance(loaded, dict):
                data = loaded
        except Exception:
            pass

    # Fallback to manual read if necessary.
    if not data:
        cfg_path = ADDON_DIR / "config.json"
        if cfg_path.exists():
            try:
                with cfg_path.open("r", encoding="utf-8") as f:
                    raw = json.load(f)
                if isinstance(raw, dict):
                    data = raw
            except Exception:
                pass

    # Merge with defaults
    merged = {**_DEFAULTS, **{k: v for k, v in data.items() if v is not None}}

    _config_cache = merged
    return merged


def reload_config() -> Dict[str, Any]:
    """Force reload of config (clears cache)."""
    global _config_cache
    _config_cache = None
    return load_config()

# (Removed) Pink Blossom auto-migration logic per user request.

# ------------------------- Stylesheet Builders ------------------------- #

def _build_menu_glow_css(cfg: Dict[str, Any]) -> str:
    """Build menu glow CSS if enabled.
    
    Note: Qt stylesheets don't support @keyframes animations.
    We use multi-layer box-shadow for static glow and QTimer-based
    stylesheet updates for animation (see _GlowAnimator).
    """
    if not cfg.get("menuGlowEnabled", False):
        return ""
    color = cfg.get("menuGlowColor", "#00ffff")
    intensity = int(cfg.get("menuGlowIntensity", 35) or 35)
    blur = int(cfg.get("menuGlowBlur", 8) or 8)
    # Single-layer glow for performance and stability
    return f"""
/* Menu Glow Effect - Optimized */
QMenuBar {{
    border: 1px solid {color};
    box-shadow: 0 0 {blur}px {color};
}}
QMenu {{
    border: 1px solid {color};
    box-shadow: 0 0 {blur}px {color};
}}
QPushButton {{
    border: 1px solid {color};
    box-shadow: 0 0 {blur}px {color};
}}
QToolBar {{
    border-bottom: 1px solid {color};
    box-shadow: 0 0 {blur}px {color};
}}
"""

def build_global_stylesheet(cfg: Dict[str, Any]) -> str:
    """Build the application-wide Qt stylesheet based on config.

    This affects main windows, toolbars, buttons, menus, inputs, lists,
    and various panel-like widgets, aiming for a modern dark aesthetic.
    """
    if not cfg.get("enableGlobalStyles", True):
        return ""

    # Note: Avoid overly specific selectors to let Anki keep layout.
    return f"""
/* {ADDON_NAME} - Global Qt Stylesheet */
QWidget {{
    background-color: {cfg['globalBackground']};
    color: {cfg['textColor']};
    font-family: {cfg['fontFamily']};
    font-size: 14px;
}}
QToolTip {{
    background: {cfg['panelBackground']};
    color: {cfg['textColor']};
    border: 1px solid {cfg['borderColor']};
    padding: 6px 8px;
    border-radius: 6px;
}}
QMainWindow, QDialog {{
    background-color: {cfg['globalBackground']};
}}
QMainWindow::separator {{
    width: 1px;
    height: 1px;
    background: {cfg['borderColor']};
}}
QToolBar {{
    background: {cfg['globalBackground']};
    spacing: 6px;
    padding: 4px 8px;
    border-bottom: 1px solid {cfg['borderColor']};
    min-height: {cfg['toolbarHeight']}px;
    max-height: {cfg['toolbarHeight']}px;
}}
QToolBar QWidget {{
    margin: 0px 2px;
}}
QToolButton {{
    background: transparent;
    color: {cfg['textColor']};
    padding: 4px 10px;
    border-radius: 6px;
}}
QToolButton:hover {{
    background: {cfg['cardBackground']};
}}
QToolButton:pressed {{
    background: {cfg['accentColor']};
    color: #fff;
}}
QMenuBar {{
    background: {cfg['globalBackground']};
    padding: 2px 4px;
    spacing: 4px;
}}
QMenuBar::item {{
    padding: 6px 12px;
    margin: 2px 4px;
    background: transparent;
    border-radius: 6px;
}}
QMenuBar::item:selected {{
    background: {cfg['cardBackground']};
    border-radius: 6px;
}}
QMenu {{
    background: {cfg['panelBackground']};
    border: 1px solid {cfg['borderColor']};
    padding: 8px 4px;
    border-radius: 8px;
}}
QMenu::item {{
    padding: 8px 20px;
    margin: 2px 4px;
    border-radius: 6px;
}}
QMenu::item:selected {{
    background: {cfg['accentColor']};
    color: #fff;
}}
QMenu::separator {{
    height: 1px;
    background: {cfg['borderColor']};
    margin: 4px 8px;
}}
QPushButton, QRadioButton, QCheckBox {{
    background: {cfg['panelBackground']};
    color: {cfg['textColor']};
    padding: 8px 16px;
    border: 1px solid {cfg['borderColor']};
    border-radius: 8px;
    min-height: 24px;
}}
QPushButton {{
    text-align: center;
    qproperty-alignment: AlignCenter;
}}
QPushButton:hover {{
    border-color: {cfg['accentColor']};
    background: {cfg['cardBackground']};
}}
QPushButton:pressed {{
    background: {cfg['accentColor']};
    color: #fff;
}}
QPushButton:disabled {{
    background: {cfg['panelBackground']};
    color: {cfg['mutedTextColor']};
