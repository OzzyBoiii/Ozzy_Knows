# ------------------------- Hook Registration ------------------------- #

def on_style_did_init(buf: str) -> str:
    """Hook into Anki's theme system to inject our stylesheet.
    
    This is called by Anki's ThemeManager and allows us to append
    CSS that will be applied with Anki's native stylesheets.
    """
    cfg = load_config()
    our_styles = build_global_stylesheet(cfg)
    addon_styles = build_addon_integration_css(cfg)
    return buf + "\n" + our_styles + "\n" + addon_styles

def _force_browser_colors(browser: Any = None) -> None:
    """Force browser window colors using Qt palette - override Anki's CANVAS_CODE with panelBackground.
    
    Args:
        browser: Browser instance. If None, tries to get from dialogs.
    """
    try:
        # If no browser passed, try to get open browser
        if not browser:
            from aqt import dialogs
            browser = dialogs.get("Browser")
        
        if browser:
            from PyQt6.QtWidgets import QAbstractScrollArea, QAbstractItemView
            cfg = load_config()
            from PyQt6.QtGui import QColor, QPalette
            palette = QPalette()
            # Parse hex colors
            panel_bg = QColor(cfg.get('panelBackground', '#2a2a35'))
            text_fg = QColor(cfg.get('textColor', '#e0e0e6'))
            accent = QColor(cfg.get('accentColor', '#4f86ff'))
            
            # Set ALL palette colors to override Anki's defaults (especially CANVAS_CODE)
            palette.setColor(QPalette.ColorRole.Base, panel_bg)
            palette.setColor(QPalette.ColorRole.AlternateBase, panel_bg)
            palette.setColor(QPalette.ColorRole.Window, panel_bg)
            palette.setColor(QPalette.ColorRole.Button, panel_bg)
            palette.setColor(QPalette.ColorRole.Light, panel_bg)
            palette.setColor(QPalette.ColorRole.Midlight, panel_bg)
            palette.setColor(QPalette.ColorRole.Dark, panel_bg)
            palette.setColor(QPalette.ColorRole.Mid, panel_bg)
            palette.setColor(QPalette.ColorRole.Shadow, panel_bg)
            palette.setColor(QPalette.ColorRole.WindowText, text_fg)
            palette.setColor(QPalette.ColorRole.Text, text_fg)
            palette.setColor(QPalette.ColorRole.ButtonText, text_fg)
            palette.setColor(QPalette.ColorRole.BrightText, text_fg)
            palette.setColor(QPalette.ColorRole.Highlight, accent)
            palette.setColor(QPalette.ColorRole.HighlightedText, QColor("#fff"))
            palette.setColor(QPalette.ColorRole.Link, accent)
            
            # Apply palette to browser window and all its children
            browser.setPalette(palette)
            browser.setAutoFillBackground(True)
            
            # Find and force ALL QAbstractItemView subclasses (QTableView, QTreeView, QListView, etc)
            for widget in browser.findChildren(QAbstractItemView):
                try:
                    widget.setPalette(palette)
                    widget.setAutoFillBackground(True)
                    if widget.viewport():
                        widget.viewport().setPalette(palette)
                        widget.viewport().setAutoFillBackground(True)
                except:
                    pass
            
            # Find and style all QAbstractScrollArea viewports
            for widget in browser.findChildren(QAbstractScrollArea):
                try:
                    if widget.viewport():
                        widget.viewport().setPalette(palette)
                        widget.viewport().setAutoFillBackground(True)
                except:
                    pass
            
            # Recursively apply palette to all child widgets
            for widget in browser.findChildren(object):
                try:
                    if hasattr(widget, 'setPalette'):
                        widget.setPalette(palette)
                    if hasattr(widget, 'setAutoFillBackground'):
                        widget.setAutoFillBackground(True)
                except:
                    pass
    except Exception:
        pass


def _on_browser_will_show(browser: Any) -> None:
    """Hook callback when Browser window is about to be shown.
    
    Force colors on the browser window to override Anki's default grays.
    Also force background on all webviews (card preview, editor).
    """
    try:
        # Apply Qt palette colors
        _force_browser_colors(browser)
        
        # Force background on all AnkiWebView instances in browser
        cfg = load_config()
        webview_bg = cfg.get('webviewBackground', '#0f0f17')
        
        try:
            from aqt.webview import AnkiWebView
            # Find all webviews in the browser window
            for child in browser.findChildren(AnkiWebView):
                try:
                    _set_webview_bg(child, webview_bg)
                except Exception:
                    pass
        except Exception:
            pass
    except Exception:
        pass


def _fix_webview_backgrounds_on_theme_change() -> None:
    """Override Anki's Qt-level webview background color.
    
    Anki sets QWebEnginePage.setBackgroundColor() to colors.CANVAS (gray).
    We override this by calling setBackgroundColor() with our webviewBackground color.
    This is the root cause fix - without this, all CSS overrides fail.
    """
    try:
        from aqt import mw
        if not mw:
            return
        cfg = load_config()
        our_color_hex = cfg.get('webviewBackground', '#0f0f17')
        
        # Fix reviewer webview
        if hasattr(mw, 'reviewer') and hasattr(mw.reviewer, 'web'):
            _set_webview_bg(mw.reviewer.web, our_color_hex)
        
        # Fix browser preview webviews
        try:
            from aqt.browser import Browser
            from aqt.browser.previewer import Previewer
            for window in mw.app.allWidgets():
                if isinstance(window, Browser):
                    if hasattr(window, '_previewer') and isinstance(window._previewer, Previewer):
                        if hasattr(window._previewer, '_web'):
                            _set_webview_bg(window._previewer._web, our_color_hex)
        except Exception:
            pass
    except Exception:
        pass


def register_hooks() -> None:
    """Register Anki GUI hooks for profile load and webview content."""
    if not gui_hooks:
        return
    try:
        # Override CANVAS before anything else initializes
        _override_canvas_palette()
        
        gui_hooks.profile_did_open.append(on_profile_did_open)
        gui_hooks.webview_will_set_content.append(inject_webview_css)
        gui_hooks.style_did_init.append(on_style_did_init)
        gui_hooks.card_review_webview_did_init.append(_on_card_review_webview_did_init)
        gui_hooks.previewer_did_init.append(_on_previewer_did_init)
        # CRITICAL: Force browser colors when browser opens (fixes gray boxes)
        gui_hooks.browser_will_show.append(_on_browser_will_show)
        # Also force colors when browser row changes (card preview updates)
        gui_hooks.browser_did_change_row.append(_on_browser_will_show)
        # Hook into theme changes - override CANVAS first, then fix webviews
        gui_hooks.theme_did_change.append(_override_canvas_palette)
        gui_hooks.theme_did_change.append(_fix_webview_backgrounds_on_theme_change)
        gui_hooks.theme_did_change.append(_patch_on_theme_did_change)
    except Exception:
        pass


# Register immediately on import.
register_hooks()

# Apply styles if mw already initialized (defensive for some reload cases).
if mw and mw.col is not None:
    apply_global_stylesheet()

# ------------------------- Minimal Logging ------------------------- #
def _log_loaded() -> None:
    """Lightweight logging compatible with modern Anki builds.

    Uses print (visible in console when launched from terminal) and a
    tooltip for quick user feedback. Avoids deprecated/internal
    attributes like mw.logWindow that no longer exist in Qt6 versions.
    """
    try:
        print(f"[{ADDON_NAME}] loaded")
        if mw:
            try:
                from aqt.utils import tooltip  # type: ignore
                mw.taskman.run_on_main(lambda: tooltip(f"{ADDON_NAME} theme active", period=2000))
            except Exception:
                pass
    except Exception:
        pass

_log_loaded()

