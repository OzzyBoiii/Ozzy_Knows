"""Universal Beautify Anki

A universal, configurable theme add-on that beautifies Anki's UI and
review cards. Compatible with Anki 2.1.60+ (Qt6/PyQt6) and keeps a
fallback for older PyQt5-based builds where possible.

All logic is contained in this file. Config values are read from
config.json using Anki's addon manager. Missing keys fall back to
sensible defaults without raising exceptions.

Features:
- Load settings from config.json
- Apply a global Qt stylesheet on profile load
- Inject custom CSS into reviewer/card webviews
- Provide functions for dynamic theme application
- Use gui_hooks.profile_did_open & gui_hooks.webview_will_set_content

"""
from __future__ import annotations

from typing import Dict, Any, Optional, Tuple
from pathlib import Path
import json
import os

try:  # Anki API imports
    from aqt import gui_hooks, mw  # type: ignore
    from aqt.webview import WebContent  # type: ignore
except Exception:  # pragma: no cover - allows safe import outside Anki
    gui_hooks = None  # type: ignore
    mw = None  # type: ignore
    WebContent = Any  # type: ignore

ADDON_NAME = "Visuals"
ADDON_ID = __name__  # directory name of this add-on
ADDON_DIR = Path(__file__).parent

