    "ADDON_NAME",
    "ADDON_ID",
    "ADDON_DIR",
    "THEME_PRESETS",
    "DEFAULTS",
    # Config
    "load_config",
    "reload_config",
    # Themes
    "get_all_presets",
    "load_custom_presets",
    "save_current_as_preset",
    "apply_preset",
    "delete_custom_preset",
    "is_builtin_preset",
    # Styling
    "build_global_stylesheet",
    "apply_global_stylesheet",
    "build_toolbar_css",
    "build_browser_editor_css",
    "build_bottom_bar_css",
    "build_webview_css",
    "build_reviewer_css",
    # Webviews & Integration
    "inject_webview_css",
    "build_addon_integration_css",
    "refresh_all_webviews",
    "get_addon_status",
    # UI
