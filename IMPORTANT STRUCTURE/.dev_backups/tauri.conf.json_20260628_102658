{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/schema.json",
  "productName": "ozzy_knows",
  "version": "0.1.0",
  "identifier": "com.ozzyknows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ozzy_knows",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../app-materials/Ozzy_Knows/Course/**/*": "app-materials/Ozzy_Knows/Course/",
      "../app-materials/Ozzy_Knows/Organization Files/**/*": "app-materials/Ozzy_Knows/Organization Files/",
      "../app-materials/Ozzy_Knows/Technical Builds/**/*": "app-materials/Ozzy_Knows/Technical Builds/",
      "../app-materials/Ozzy_Knows/Logo.png": "app-materials/Ozzy_Knows/Logo.png",
      "../app-materials/Ozzy_Knows/OZZY_knows.html": "app-materials/Ozzy_Knows/OZZY_knows.html",
      "../app-materials/Ozzy_Knows/README.md": "app-materials/Ozzy_Knows/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
